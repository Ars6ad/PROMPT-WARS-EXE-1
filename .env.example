# FairShift Environment Configuration Template
# In demo sandbox mode, no external keys are required. The application runs with a full in-memory mock repository.

# Application Server
PORT=3000
NODE_ENV=production

# Optional Supabase Integration (Leave blank to use built-in offline-ready mock data)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional Google Cloud Run Metadata
# K_SERVICE=fairshift-app
# K_REVISION=fairshift-app-00001
